# =============================================================================
# CurioMap Local Development Environment Variables (.env)
# Copy this file to .env and adjust values as needed.
# .env is ignored by git to protect credentials and local overrides.
#
# SECURITY: the JWT__SECRET below is a PUBLIC, dev-only fallback constant.
# It is safe for local docker-compose use. NEVER set it (or anything like it)
# as a Fly secret or production env var — generate a fresh 64-char random
# string for every real deployment (see docs/deployment.md).
# =============================================================================

# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Development

# Demo seed data (book catalog always seeds; demo READERS only when true).
# Default true for local dev convenience. CI sets false. Fly/prod MUST be false.
Seed__DemoReaders=true

# Database Configuration (Postgres)
# Local docker-compose runs on port 5433 by default
DATABASE_URL=postgres://curiomap:curiomap@localhost:5433/curiomap
# Alternatively standard Npgsql connection string:
# ConnectionStrings__Database="Host=localhost;Port=5433;Database=curiomap;Username=curiomap;Password=curiomap"

# Redis Cache & Distributed Rate Limiting
# Local docker-compose runs on port 6380 by default
REDIS_URL=localhost:6380
# Alternatively:
# ConnectionStrings__Redis="localhost:6380"

# JWT Authentication Secrets & Parameters
# Must be at least 32 characters in length
JWT__SECRET=dev-only-secret-change-me-0123456789abcdef0123456789abcdef
JWT__ISSUER=https://curiomap.local
JWT__AUDIENCE=curiomap
JWT__ACCESSTOKENMINUTES=15
JWT__REFRESHTOKENDAYS=30

# Administrator Emails (promoted to Admin role upon registration)
Admin__Emails__0=admin@curiomap.local
Admin__Emails__1=admin@curiomap.app

# Affiliate Partner Tags
Affiliate__AmazonTag=curiomap-20

# Frontend Next.js API Proxy Target
API_INTERNAL_URL=http://localhost:8080
PORT=3000

# Frontend map basemap tiles (ADR 0007).
# Default is the OpenStreetMap standard raster layer. The OSMF tile usage policy
# asks consumers not to hard-code a provider, so keep this configurable and swap
# it (self-hosted or a paid OSM-derived provider) before any real traffic.
# Any replacement MUST keep visible attribution and may not be fetched in bulk.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
