{
  "name": "curiomap",
  "version": "0.1.0",
  "private": true,
  "description": "CurioMap local dev orchestrator (docker + API + UI). Run `npm run dev` from repo root.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:only-ui": "node scripts/dev.mjs --only-ui",
    "smoke": "powershell -ExecutionPolicy Bypass -File scripts/smoke.ps1"
  }
}
