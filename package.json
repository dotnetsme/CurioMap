{
  "name": "curiomap",
  "version": "0.1.0",
  "private": true,
  "description": "CurioMap local dev orchestrator (docker + API + UI). Run `npm run dev` from repo root.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:only-ui": "node scripts/dev.mjs --only-ui",
    "smoke": "powershell -ExecutionPolicy Bypass -File scripts/smoke.ps1",
    "verify:map": "node scripts/verify-map-engine.mjs && node scripts/verify-map-live.mjs",
    "verify:map:e2e": "node scripts/verify-map-stack.mjs",
    "audit:routes": "node scripts/verify-route-coverage.mjs",
    "audit:routes:strict": "node scripts/verify-route-coverage.mjs --strict"
  }
}
