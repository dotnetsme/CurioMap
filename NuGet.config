<?xml version="1.0" encoding="utf-8"?>
<!--
  CurioMap restore is pinned to the public NuGet feed plus the bundled offline
  packages folder. All machine/user-level feeds are cleared so restores are
  reproducible and cannot fail on unreachable third-party sources (e.g. the
  Telerik v3 feed), which previously broke `dotnet format`/CI MSBuild loads.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="Microsoft Visual Studio Offline Packages" value="C:\Program Files (x86)\Microsoft SDKs\NuGetPackages\" />
  </packageSources>
</configuration>