{
  "ConnectionStrings": {
    "Database": "",
    "Redis": ""
  },
  "Jwt": {
    "Issuer": "https://curiomap.local",
    "Audience": "curiomap",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "Secret": ""
  },
  "Cors": {
    "Origins": [
      "http://localhost:3123",
      "http://localhost:3000",
      "http://localhost:3001"
    ]
  },
  "Proxy": {
    "TrustedNetworks": [
      "fdaa::/16",
      "::1/128",
      "127.0.0.1/32"
    ],
    "ClientIpHeaders": [
      "Fly-Client-IP",
      "X-Forwarded-For"
    ]
  },
  "Admin": {
    "Emails": []
  },
  "Affiliate": {
    "AmazonTag": ""
  },
  "OpenLibrary": {
    "Enabled": true
  },
  "GoogleBooks": {
    "Enabled": false,
    "ApiKey": ""
  },
  "Conversations": {
    "AutoArchiveDays": 30
  },
  "Email": {
    "Provider": "Smtp",
    "FromEmail": "noreply@curiomap.com",
    "FromName": "CurioMap",
    "Smtp": {
      "Host": "localhost",
      "Port": 2525,
      "EnableSsl": false
    },
    "Resend": {
      "ApiKey": ""
    }
  },

  "Seed": {
    "DemoReaders": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
