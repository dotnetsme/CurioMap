# =============================================================================
# CurioMap .gitignore
# Comprehensive rules for .NET 10, Next.js 16, Postgres/Redis, secrets, and IDEs
# =============================================================================

# -----------------------------------------------------------------------------
# Secrets, Environment & Credentials (NEVER COMMIT)
# -----------------------------------------------------------------------------
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.token
secrets.json
appsettings.*.local.json

# -----------------------------------------------------------------------------
# .NET / C# Build Outputs
# -----------------------------------------------------------------------------
[Bb]in/
[Oo]bj/
[Aa]rtifacts/
[Tt]est[Rr]esults/
*.user
*.userosscache
*.suo
*.userprefs
*.DotSettings
*.DotSettings.user
*.pidb
*.booproj
*.svclog
*.crash
project.lock.json
project.fragment.lock.json
*.nuget.props
*.nuget.targets

# -----------------------------------------------------------------------------
# Node.js / Next.js / Frontend
# -----------------------------------------------------------------------------
node_modules/
.next/
out/
build/
dist/
.eslintcache
.tsbuildinfo
*.tsbuildinfo
next-env.d.ts.bak
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# -----------------------------------------------------------------------------
# IDEs, Editors & Developer Tooling
# -----------------------------------------------------------------------------
.vs/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*~

# -----------------------------------------------------------------------------
# Operating System Files
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# -----------------------------------------------------------------------------
# Logs, Diagnostic Dumps & Smoke Test Artifacts
# -----------------------------------------------------------------------------
*.log
*.log.*
*.err
*.out
frontend/lint*.txt
frontend/*-err.txt
frontend/build-log*.txt
frontend/frontend-*.log
frontend/tail-*.txt
frontend/pre-err.txt
smoke-*.txt
smoke-*.log
.api-pid
.cookies.txt
cookies.txt

# Stray editor/agent temp files (e.g. page.tsx.new left by an interrupted edit)
*.new

# -----------------------------------------------------------------------------
# Docker & Local Infrastructure Data
# -----------------------------------------------------------------------------
.docker/
docker-compose.override.yml
*.pgdata
*.redisdata

# -----------------------------------------------------------------------------
# Fly.io & Deployment Artifacts
# -----------------------------------------------------------------------------
*.flyc

# -----------------------------------------------------------------------------
# Agent & Codebase Memory Graph Stores (Local DBs)
# Note: Persisted artifact .codebase-memory/graph.db.zst is tracked if shared
# -----------------------------------------------------------------------------
.codebase-memory/*.db
.codebase-memory/*.db-wal
.codebase-memory/*.db-shm
.codebase-memory/*.stage.*
